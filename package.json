{
  "name": "showrunner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-env.mjs && tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@libsql/client": "^0.17.0",
    "crypto-js": "^4.2.0",
    "pdfjs-dist": "5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tesseract.js": "^7.0.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.61.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gifenc": "^1.0.3",
    "globals": "^16.5.0",
    "playwright": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.7"
  }
}
